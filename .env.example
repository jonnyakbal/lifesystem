# Authentication
AUTH_USER=your-user
AUTH_PASSWORD=use-a-long-unique-password
MCP_API_KEYS=[]
LIFESYSTEM_DATA_DIR=/absolute/path/outside/the/release

# Optional Cloudflare D1 storage (docs/cloudflare-d1-workers-ai.md).
# Keep "file" until the collections were imported with scripts/d1-import.mjs.
LIFESYSTEM_STORAGE=file
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# Token limited to Account > D1 > Edit.
CLOUDFLARE_D1_API_TOKEN=

# Optional Workers AI provider; uses CLOUDFLARE_ACCOUNT_ID above.
# Token limited to Account > Workers AI > Read.
AI_CLOUDFLARE_API_KEY=

# Google Calendar shared OAuth integration
# Register https://your-domain/api/google-calendar/callback as the OAuth redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://lifesystem.oj0nny.com/api/google-calendar/callback
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
